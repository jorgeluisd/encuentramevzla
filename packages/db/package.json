{
  "name": "@evzla/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./ingest": "./src/patient-registry/drizzle-repositories.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "reconcile": "tsx scripts/reconciliation/reconcile.ts",
    "lint": "echo \"(db) lint stub\" && exit 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@evzla/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@evzla/config": "workspace:*",
    "@types/node": "22.20.0",
    "drizzle-kit": "0.31.10",
    "exceljs": "4.4.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
