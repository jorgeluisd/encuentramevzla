# --- Postgres (dev local) ---
# En AWS la app NO usa estas variables: lee las credenciales de Secrets Manager (ver abajo).
# Cadena de conexión para todos los roles en dev. Solo backend / migraciones.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/encuentramevzla
# (Opcional) Una URL por rol para probar los permisos reales en local.
# DATABASE_URL_ADMIN=postgresql://evzla_admin:...@localhost:5432/encuentramevzla
# DATABASE_URL_PUBLIC=postgresql://evzla_public:...@localhost:5432/encuentramevzla

# --- AWS (solo en Lambda; los fija la infraestructura) ---
# Nombre o ARN del secreto JSON {host,port,dbname,username,password} de cada rol de base.
# EVZLA_DB_SECRET_ADMIN=evzla/db/admin
# EVZLA_DB_SECRET_PUBLIC=evzla/db/public
# EVZLA_DB_SECRET_JOB=evzla/db/job
# Nombre o ARN del secreto JSON con las claves de la app (las de "Secretos de la app" abajo).
# Si existe, esas claves se leen de ahí y NO de process.env.
# EVZLA_APP_SECRET=evzla/app
# Bucket de subidas de Excel (URL prefirmada). Sin él, el Excel viaja en la Server Action (dev).
# EVZLA_UPLOADS_BUCKET=evzla-uploads-<account-id>
# AWS_REGION=sa-east-1

# Secreto compartido con CloudFront (header x-origin-verify). Sin él (local) no se chequea.
# ORIGIN_VERIFY_SECRET=
# CA del runtime de Lambda para TLS verify-full contra RDS.
# NODE_EXTRA_CA_CERTS=/var/runtime/ca-cert.pem

# --- Auth del portal /admin (Cognito, EMAIL_OTP sin contraseña) ---
COGNITO_USER_POOL_ID=sa-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_REGION=sa-east-1

# --- Secretos de la app (dev local; en AWS van en EVZLA_APP_SECRET) ---
# Cloudflare Turnstile (servidor, siteverify). En local usa las claves de PRUEBA de Cloudflare.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Sal para hashear la IP en el rate-limit (no reversible). Cadena aleatoria larga.
RATE_LIMIT_IP_SALT=change-me-to-a-long-random-string
# Token del endpoint POST /api/revalidate.
REVALIDATE_TOKEN=change-me
# Dictado por voz (STT + extracción).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Resend (correo transaccional). Vacía → el envío hace no-op y el alta NO se bloquea.
RESEND_API_KEY=

# --- Config pública ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Remitente verificado en Resend (dominio con SPF/DKIM). Formato: "Nombre <correo@dominio>".
MAIL_FROM=EncuéntrameVzla <no-reply@encuentramevzla.com>
# (Opcional) URL de descarga del Manual de Usuario (PDF). Si falta, el correo omite el bloque.
NEXT_PUBLIC_MANUAL_URL=
